<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NexusWindows.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 runs natively on Microsoft.Testing.Platform (global.json): no VSTest adapter or test SDK. Jint
         executes the DOM scripts the engine injects into Chromium pages. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\commun\engine\NexusWindows.Engine.csproj" />
    <ProjectReference Include="..\commun\launcher\NexusWindows.Launcher.csproj" />
  </ItemGroup>
</Project>
