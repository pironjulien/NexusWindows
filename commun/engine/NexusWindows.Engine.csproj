<Project Sdk="Microsoft.NET.Sdk">
  <!-- The common engine of the three profiles. Built here as NexusWindows.Engine, next to the launcher (NexusWindows) in
       the test output; installers and releases publish it as NexusWindows (-p:AssemblyName=NexusWindows). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NexusWindows.Engine</AssemblyName>
    <Version>3.17.10</Version>
    <!-- The runtime content is identified by its SHA-256: never stamp it with the last commit when a qualification is
         built from the current worktree. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Trimming, single-file and Native AOT analyzers in every build: with warnings as errors, no reflection-based JSON,
         runtime COM binder or marshalled delegate can come back. The engine has zero such warning and publishes with
         PublishAot (12.6 MB, one file): releases ship it that way (commun/package.ps1), and the installers, the
         stable launcher and NexusSystem accept that single-file layout (README, Development). -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Outputs of a build made in this folder (obj, bin) are never compiled as sources when the installer moves
         BaseIntermediateOutputPath out of OneDrive (duplicate AssemblyInfo, Codex review of 24/10). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logo of the "agent at work" indicator (BusyIndicator.cs), read next to the executable. -->
    <None Include="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="NativeSchemas.json" LogicalName="NexusWindows.Contracts" />
    <!-- xUnit tests (tests/) call the engine in-process. -->
    <InternalsVisibleTo Include="NexusWindows.Tests" />
  </ItemGroup>
</Project>
