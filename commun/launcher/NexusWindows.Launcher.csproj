<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stable entry point %USERPROFILE%\.nexus\nexus-windows\NexusWindows.exe (Program.cs). Native AOT: one small file,
       no .NET runtime needed, so it can be swapped while MCP hosts keep an older copy running. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexusWindows</AssemblyName>
    <RootNamespace>NexusWindows.Launcher</RootNamespace>
    <Version>3.11.0</Version>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NexusWindows.Tests" />
  </ItemGroup>
</Project>
